<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_shop" model="ir.ui.view">
        <field name="name">sale.order.form.shop</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='order_details']" position="inside">
                <field name="shop_id" options="{'no_create': True}"/>
                <field name="shop_website_id" options="{'no_create': True}"
                       invisible="not shop_website_id and not website_id"/>
            </xpath>
        </field>
    </record>
</odoo>
