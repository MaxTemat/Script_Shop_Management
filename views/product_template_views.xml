<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_view_shop" model="ir.ui.view">
        <field name="name">product.template.form.shop</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="shop_ids" widget="many2many_tags"
                       groups="script_shop_management.group_shop_manager"
                       options="{'no_create': True}"/>
                <field name="shop_website_ids" widget="many2many_tags"
                       groups="script_shop_management.group_shop_manager"
                       options="{'no_create': True}"/>
            </field>
        </field>
    </record>
</odoo>
