<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="pos_config_view_form_shop" model="ir.ui.view">
        <field name="name">pos.config.form.shop</field>
        <field name="model">pos.config</field>
        <field name="inherit_id" ref="point_of_sale.pos_config_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id='title']" position="before">
                <field name="shop_image" widget="image" class="oe_avatar"/>
            </xpath>
            <xpath expr="//div[@id='title']" position="after">
                <group name="shop_info">
                    <field name="is_shop"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
