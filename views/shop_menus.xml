<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Menus: visible to the shop users and managers (see security/security.xml) -->
    <menuitem id="menu_shop_root" name="Script Shop Management"
              web_icon="script_shop_management,static/description/icon.png" sequence="50"
              groups="group_shop_user"/>
    <menuitem id="menu_shop_dashboard" name="Dashboard" parent="menu_shop_root"
              action="shop_dashboard_action" sequence="10"/>
    <menuitem id="menu_shop_purchase" name="Purchases" parent="menu_shop_root"
              action="shop_purchase_order_action" sequence="20"/>
    <menuitem id="menu_shop_orders" name="Orders" parent="menu_shop_root"
              action="shop_order_action" sequence="30"/>
    <menuitem id="menu_shop_stock" name="Stock" parent="menu_shop_root"
              action="shop_stock_picking_action" sequence="40"/>
    <menuitem id="menu_shop_websites" name="Online Shops" parent="menu_shop_root"
              action="shop_website_action" sequence="50"/>
</odoo>
