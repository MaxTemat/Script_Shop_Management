<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Stock transfers to a shop -->
    <record id="shop_stock_picking_view_list" model="ir.ui.view">
        <field name="name">shop.stock.picking.list</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <list string="Transfers to Shops" create="0">
                <field name="name" string="Reference"/>
                <field name="shop_id"/>
                <field name="shop_website_id" optional="show"/>
                <field name="partner_id" optional="show"/>
                <field name="location_id" optional="hide"/>
                <field name="location_dest_id" optional="hide"/>
                <field name="scheduled_date" optional="show"/>
                <field name="origin" optional="show"/>
                <field name="picking_type_id" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="shop_stock_picking_view_search" model="ir.ui.view">
        <field name="name">shop.stock.picking.search</field>
        <field name="model">stock.picking</field>
        <field name="arch" type="xml">
            <search string="Search Transfers">
                <field name="name" string="Reference"/>
                <field name="shop_id"/>
                <field name="shop_website_id"/>
                <field name="product_id" string="Product"/>
                <field name="origin"/>
                <filter name="filter_ready" string="Ready" domain="[('state', '=', 'assigned')]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <group>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'shop_id'}"/>
                    <filter name="group_online_shop" string="Online Shop" context="{'group_by': 'shop_website_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shop_stock_picking_action" model="ir.actions.act_window">
        <field name="name">Stock</field>
        <field name="res_model">stock.picking</field>
        <field name="view_mode">list,form</field>
        <field name="domain">['|', ('shop_id', '!=', False), ('shop_website_id', '!=', False)]</field>
        <field name="search_view_id" ref="shop_stock_picking_view_search"/>
    </record>
    <record id="shop_stock_picking_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="shop_stock_picking_view_list"/>
        <field name="act_window_id" ref="shop_stock_picking_action"/>
    </record>
    <record id="shop_stock_picking_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="stock.view_picking_form"/>
        <field name="act_window_id" ref="shop_stock_picking_action"/>
    </record>
</odoo>
