<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Purchases with a destination shop -->
    <record id="shop_purchase_order_view_list" model="ir.ui.view">
        <field name="name">shop.purchase.order.list</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <list string="Purchases by Shop" create="0">
                <field name="name" string="Reference"/>
                <field name="date_approve" string="Confirmation Date"/>
                <field name="partner_id"/>
                <field name="shop_id"/>
                <field name="date_planned" optional="show"/>
                <field name="company_id" column_invisible="True"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="state" widget="badge" optional="show"/>
            </list>
        </field>
    </record>

    <record id="shop_purchase_order_view_search" model="ir.ui.view">
        <field name="name">shop.purchase.order.search</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <search string="Search Purchases">
                <field name="name" string="Reference"/>
                <field name="shop_id"/>
                <field name="order_line" string="Product"
                       filter_domain="[('order_line.product_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <filter name="filter_confirmed" string="Confirmed"
                        domain="[('state', 'in', ('purchase', 'done'))]"/>
                <filter name="filter_draft" string="Drafts"
                        domain="[('state', 'in', ('draft', 'sent', 'to approve'))]"/>
                <group>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'shop_id'}"/>
                    <filter name="group_partner" string="Vendor" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shop_purchase_order_action" model="ir.actions.act_window">
        <field name="name">Purchases</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('shop_id', '!=', False)]</field>
        <field name="search_view_id" ref="shop_purchase_order_view_search"/>
    </record>
    <record id="shop_purchase_order_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="shop_purchase_order_view_list"/>
        <field name="act_window_id" ref="shop_purchase_order_action"/>
    </record>
    <record id="shop_purchase_order_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="purchase.purchase_order_form"/>
        <field name="act_window_id" ref="shop_purchase_order_action"/>
    </record>
</odoo>
