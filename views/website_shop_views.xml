<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Online shops: the websites that are shops. Read by the users, edited by the managers. -->
    <record id="shop_website_view_list" model="ir.ui.view">
        <field name="name">shop.website.list</field>
        <field name="model">website</field>
        <field name="arch" type="xml">
            <list string="Online Shops" create="0" delete="0">
                <field name="name"/>
                <field name="domain" optional="show"/>
                <field name="local_shop_id"/>
                <field name="destination_shop_id" optional="hide"/>
                <field name="warehouse_id" optional="show"/>
                <field name="company_id" groups="base.group_multi_company" optional="show"/>
            </list>
        </field>
    </record>

    <record id="shop_website_action" model="ir.actions.act_window">
        <field name="name">Online Shops</field>
        <field name="res_model">website</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_shop', '=', True)]</field>
    </record>
    <record id="shop_website_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="shop_website_view_list"/>
        <field name="act_window_id" ref="shop_website_action"/>
    </record>
    <record id="shop_website_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="website.view_website_form"/>
        <field name="act_window_id" ref="shop_website_action"/>
    </record>
</odoo>
