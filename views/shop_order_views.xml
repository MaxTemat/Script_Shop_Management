<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Orders of the shops: point of sale orders and website orders -->
    <record id="shop_order_view_list" model="ir.ui.view">
        <field name="name">shop.order.list</field>
        <field name="model">shop.order</field>
        <field name="arch" type="xml">
            <list string="Shop Orders" create="0" edit="0" delete="0"
                  action="action_open_order" type="object">
                <field name="name" string="Order"/>
                <field name="date_order"/>
                <field name="channel" widget="badge"
                       decoration-info="channel == 'online'" decoration-primary="channel == 'local'"/>
                <field name="shop_id"/>
                <field name="shop_website_id" optional="show"/>
                <field name="partner_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="amount_untaxed" sum="Untaxed Amount" widget="monetary" optional="hide"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="shop_order_view_search" model="ir.ui.view">
        <field name="name">shop.order.search</field>
        <field name="model">shop.order</field>
        <field name="arch" type="xml">
            <search string="Search Orders">
                <field name="name" string="Order"/>
                <field name="shop_id" domain="[('is_shop', '=', True)]"/>
                <field name="shop_website_id" domain="[('is_shop', '=', True)]"/>
                <field name="partner_id"/>
                <filter name="filter_local" string="Local" domain="[('channel', '=', 'local')]"/>
                <filter name="filter_online" string="Online" domain="[('channel', '=', 'online')]"/>
                <group>
                    <filter name="group_channel" string="Channel" context="{'group_by': 'channel'}"/>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'shop_id'}"/>
                    <filter name="group_online_shop" string="Online Shop" context="{'group_by': 'shop_website_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'date_order:day'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shop_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">shop.order</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="shop_order_view_search"/>
    </record>
</odoo>
