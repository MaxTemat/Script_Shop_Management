<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Transfers: every stock movement of the warehouses of the shops -->
    <record id="shop_stock_move_view_list" model="ir.ui.view">
        <field name="name">shop.stock.move.list</field>
        <field name="model">shop.stock.move</field>
        <field name="arch" type="xml">
            <list string="Stock Movements" create="0" edit="0" delete="0"
                  action="action_open_transfer" type="object">
                <field name="date"/>
                <field name="reference"/>
                <field name="picking_id" optional="hide"/>
                <field name="product_id"/>
                <field name="quantity" sum="Quantity"/>
                <field name="location_id"/>
                <field name="location_dest_id"/>
                <field name="shop_name"/>
                <field name="direction" widget="badge"
                       decoration-success="direction == 'in'" decoration-danger="direction == 'out'"
                       decoration-info="direction == 'internal'"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="shop_stock_move_view_search" model="ir.ui.view">
        <field name="name">shop.stock.move.search</field>
        <field name="model">shop.stock.move</field>
        <field name="arch" type="xml">
            <search string="Search Movements">
                <field name="reference"/>
                <field name="picking_id"/>
                <field name="product_id"/>
                <field name="shop_id" domain="[('is_shop', '=', True)]"/>
                <field name="shop_website_id" domain="[('is_shop', '=', True)]"/>
                <filter name="filter_done" string="Done" domain="[('state', '=', 'done')]"/>
                <filter name="filter_ready" string="Ready" domain="[('state', '=', 'assigned')]"/>
                <separator/>
                <filter name="filter_in" string="Entries" domain="[('direction', '=', 'in')]"/>
                <filter name="filter_out" string="Exits" domain="[('direction', '=', 'out')]"/>
                <group>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'shop_name'}"/>
                    <filter name="group_product" string="Product" context="{'group_by': 'product_id'}"/>
                    <filter name="group_direction" string="Direction" context="{'group_by': 'direction'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'date:day'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shop_stock_move_action" model="ir.actions.act_window">
        <field name="name">Transfers</field>
        <field name="res_model">shop.stock.move</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="shop_stock_move_view_search"/>
    </record>
</odoo>
