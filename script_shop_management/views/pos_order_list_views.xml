<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Point of sale orders of the shops -->
    <record id="shop_pos_order_view_list" model="ir.ui.view">
        <field name="name">shop.pos.order.list</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <list string="Shop Orders" create="0">
                <field name="name" string="Order"/>
                <field name="pos_reference" string="Receipt"/>
                <field name="date_order"/>
                <field name="config_id" string="Shop"/>
                <field name="partner_id"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="amount_total" sum="Total" widget="monetary"/>
                <field name="state" widget="badge"/>
            </list>
        </field>
    </record>

    <record id="shop_pos_order_view_search" model="ir.ui.view">
        <field name="name">shop.pos.order.search</field>
        <field name="model">pos.order</field>
        <field name="arch" type="xml">
            <search string="Search Orders">
                <field name="name" string="Order"/>
                <field name="pos_reference" string="Receipt"/>
                <field name="config_id" string="Shop"/>
                <field name="lines" string="Product"
                       filter_domain="[('lines.product_id', 'ilike', self)]"/>
                <field name="partner_id"/>
                <filter name="filter_paid" string="Paid"
                        domain="[('state', 'in', ('paid', 'done', 'invoiced'))]"/>
                <group>
                    <filter name="group_shop" string="Shop" context="{'group_by': 'config_id'}"/>
                    <filter name="group_day" string="Day" context="{'group_by': 'date_order:day'}"/>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="shop_pos_order_action" model="ir.actions.act_window">
        <field name="name">Orders</field>
        <field name="res_model">pos.order</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('config_id.is_shop', '=', True)]</field>
        <field name="search_view_id" ref="shop_pos_order_view_search"/>
    </record>
    <record id="shop_pos_order_action_list" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">list</field>
        <field name="view_id" ref="shop_pos_order_view_list"/>
        <field name="act_window_id" ref="shop_pos_order_action"/>
    </record>
    <record id="shop_pos_order_action_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="point_of_sale.view_pos_pos_form"/>
        <field name="act_window_id" ref="shop_pos_order_action"/>
    </record>
</odoo>
