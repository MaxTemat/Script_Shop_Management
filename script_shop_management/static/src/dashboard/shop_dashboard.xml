<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-name="script_shop_management.ShopDashboard">
        <div class="o_shop_dashboard o_action overflow-auto p-3 p-lg-4">

            <!-- Screen 1: one card for all the shops, then one card per shop -->
            <t t-if="!state.shop">
                <h2 class="o_shop_title mb-4">Shops</h2>
                <div class="o_shop_cards">
                    <t t-foreach="state.shops" t-as="shop" t-key="shop.id">
                        <div class="o_shop_card" role="button" t-on-click="() => this.openShop(shop)">
                            <div class="o_shop_card_image">
                                <img t-att-src="shop.image_url" t-att-alt="shop.name"/>
                            </div>
                            <div class="o_shop_card_body">
                                <h4 class="mb-1" t-esc="shop.name"/>
                                <span t-if="!shop.id" class="text-muted">
                                    <t t-esc="shop.shop_count"/> shop(s)
                                </span>
                            </div>
                        </div>
                    </t>
                </div>
                <p t-if="state.shops.length === 1" class="text-muted mt-4">
                    No shop yet: tick "Is a Shop" on a point of sale to see it here.
                </p>
            </t>

            <!-- Screen 2: dashboard of the selected card -->
            <t t-else="">
                <div class="o_shop_banner mb-4">
                    <div class="d-flex align-items-center gap-3">
                        <button class="o_shop_back" t-on-click="backToShops" title="Shops">
                            <i class="fa fa-arrow-left"/>
                        </button>
                        <img class="o_shop_banner_logo" t-att-src="state.shop.image_url" t-att-alt="state.shop.name"/>
                        <h2 class="mb-0" t-esc="state.shop.name"/>
                    </div>
                    <div class="o_shop_periods">
                        <div class="o_shop_pills">
                            <t t-foreach="periods" t-as="period" t-key="period.key">
                                <button t-attf-class="o_shop_pill #{state.period === period.key ? 'active' : ''}"
                                        t-on-click="() => this.selectPeriod(period.key)"
                                        t-esc="period.label"/>
                            </t>
                        </div>
                        <div class="o_shop_dates">
                            <input type="date" t-att-value="state.dateFrom"
                                   t-on-change="(ev) => this.onDateChange('dateFrom', ev)"/>
                            <span>→</span>
                            <input type="date" t-att-value="state.dateTo"
                                   t-on-change="(ev) => this.onDateChange('dateTo', ev)"/>
                        </div>
                    </div>
                </div>

                <t t-if="state.data">
                    <div class="o_shop_kpis mb-4">
                        <div class="o_shop_kpi o_shop_kpi_purchases" role="button"
                             t-on-click="() => this.openList('shop_purchase_order_action', 'shop_id')">
                            <div class="o_shop_kpi_icon"><i class="fa fa-shopping-basket"/></div>
                            <div>
                                <div class="o_shop_kpi_label">Purchases</div>
                                <div class="o_shop_kpi_value" t-esc="money(state.data.purchases.amount)"/>
                                <div class="o_shop_kpi_hint"><t t-esc="state.data.purchases.count"/> confirmed order(s)</div>
                            </div>
                        </div>
                        <div class="o_shop_kpi o_shop_kpi_sales" role="button"
                             t-on-click="() => this.openList('shop_pos_order_action', 'config_id')">
                            <div class="o_shop_kpi_icon"><i class="fa fa-shopping-cart"/></div>
                            <div>
                                <div class="o_shop_kpi_label">Sales</div>
                                <div class="o_shop_kpi_value" t-esc="money(state.data.sales.amount)"/>
                                <div class="o_shop_kpi_hint">
                                    <t t-esc="state.data.sales.count"/> order(s),
                                    <t t-esc="state.data.sales.refund_count"/> refund(s)
                                </div>
                            </div>
                        </div>
                        <div class="o_shop_kpi o_shop_kpi_revenue">
                            <div class="o_shop_kpi_icon"><i class="fa fa-line-chart"/></div>
                            <div>
                                <div class="o_shop_kpi_label">Real turnover</div>
                                <div class="o_shop_kpi_value" t-esc="money(state.data.sales.real_revenue)"/>
                                <div class="o_shop_kpi_hint">Tax excluded, net of refunds</div>
                            </div>
                        </div>
                        <div class="o_shop_kpi o_shop_kpi_stock" role="button"
                             t-on-click="() => this.openList('shop_stock_picking_action', 'shop_id')">
                            <div class="o_shop_kpi_icon"><i class="fa fa-cubes"/></div>
                            <div>
                                <div class="o_shop_kpi_label">Stock</div>
                                <div class="o_shop_kpi_value" t-esc="money(state.data.stock.value)"/>
                                <div class="o_shop_kpi_hint">
                                    <t t-esc="state.data.stock.quantity"/> unit(s),
                                    <t t-esc="state.data.stock.received_transfers"/> transfer(s) received
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="o_shop_grid mb-4">
                        <div class="o_shop_panel o_shop_panel_wide">
                            <div class="o_shop_panel_title">Turnover and purchases</div>
                            <div class="o_shop_chart"><canvas t-ref="timelineChart"/></div>
                        </div>
                        <div class="o_shop_panel">
                            <div class="o_shop_panel_title" t-esc="shareTitle"/>
                            <div class="o_shop_chart"><canvas t-ref="shareChart"/></div>
                        </div>
                    </div>

                    <div class="o_shop_grid">
                        <div class="o_shop_panel o_shop_panel_wide">
                            <div class="o_shop_panel_title">Best-selling products</div>
                            <div class="o_shop_chart o_shop_chart_small"><canvas t-ref="topChart"/></div>
                            <p t-if="!state.data.top_products.length" class="text-muted mb-0">
                                No sales over this period.
                            </p>
                        </div>
                        <div class="o_shop_panel">
                            <div class="o_shop_panel_title">Least-selling products</div>
                            <ul class="o_shop_flop list-unstyled mb-0">
                                <li t-foreach="state.data.flop_products" t-as="product" t-key="product.id">
                                    <span class="o_shop_flop_name" t-esc="product.name"/>
                                    <span class="o_shop_flop_qty" t-esc="product.qty"/>
                                </li>
                            </ul>
                            <p t-if="!state.data.flop_products.length" class="text-muted mb-0">
                                No product assigned to this shop.
                            </p>
                        </div>
                    </div>
                </t>
                <div t-else="" class="text-muted">Loading…</div>
            </t>
        </div>
    </t>
</templates>
