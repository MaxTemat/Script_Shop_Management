<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_groups_privilege_shop_management" model="res.groups.privilege">
        <field name="name">Script Shop Management</field>
        <field name="sequence">22</field>
        <field name="category_id" ref="base.module_category_sales"/>
    </record>

    <!-- User: sees the dashboard and the purchases, orders and stock of the shops (read access to the
         online orders, which are opened from the Orders menu, comes with the sales "all documents" group) -->
    <record id="group_shop_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_shop_management"/>
        <field name="implied_ids" eval="[
            (4, ref('point_of_sale.group_pos_user')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('sales_team.group_sale_salesman_all_leads')),
        ]"/>
    </record>

    <!-- Manager: also sets up the shops (shop flag, image, products of each shop, online shops) -->
    <record id="group_shop_manager" model="res.groups">
        <field name="name">Manager</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_shop_management"/>
        <field name="implied_ids" eval="[
            (4, ref('group_shop_user')),
            (4, ref('point_of_sale.group_pos_manager')),
            (4, ref('purchase.group_purchase_manager')),
            (4, ref('stock.group_stock_manager')),
        ]"/>
        <field name="user_ids" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- The orders of the shops only show the orders of the companies of the user -->
    <record id="shop_order_company_rule" model="ir.rule">
        <field name="name">Shop order: multi-company</field>
        <field name="model_id" ref="model_shop_order"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="shop_stock_company_rule" model="ir.rule">
        <field name="name">Shop stock: multi-company</field>
        <field name="model_id" ref="model_shop_stock"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="shop_stock_move_company_rule" model="ir.rule">
        <field name="name">Shop stock movement: multi-company</field>
        <field name="model_id" ref="model_shop_stock_move"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
